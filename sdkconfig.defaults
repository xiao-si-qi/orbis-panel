# =============================================================================
#  JC3636W518 : ESP32-S3R8 + 1.85" round 360x360 ST77916 panel
#  Target is fixed to esp32s3; these defaults apply when sdkconfig is
#  (re)generated, i.e. after `idf.py set-target esp32s3`.
# =============================================================================

CONFIG_IDF_TARGET="esp32s3"

# ---------- CPU ----------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---------- Flash: 16MB @80MHz ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---------- PSRAM: 8MB Octal @80MHz (ESP32-S3R8) ----------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ---------- Partition table ----------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- FreeRTOS ----------
CONFIG_FREERTOS_HZ=1000

# ---------- Main task stack ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---------- LVGL 9 (Kconfig driven, no lv_conf.h needed) ----------
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_FONT_SIMSUN_16_CJK=n
# 空 = 自动发现；填 entity_id 可指定传感器槽位
CONFIG_APP_SENSOR_1=""
CONFIG_APP_SENSOR_2=""
CONFIG_APP_SENSOR_3=""
CONFIG_APP_SENSOR_4=""
